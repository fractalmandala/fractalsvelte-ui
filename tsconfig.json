{
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"strict": true,
		"paths": {
			"$lib": ["./src/lib"],
			"$lib/*": ["./src/lib/*"],
			"#lib": ["./src/lib"],
			"#lib/*": ["./src/lib/*"],
			"$site": ["./src/site"],
			"$site/*": ["./src/site/*"]
		}
	},
	"include": ["src", "vite.config.ts", "scripts"]
}
