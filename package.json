{
	"name": "@fractaldesign/fractalsvelte-ui",
	"version": "1.0.0",
	"description": "Massive, modern, token-driven Svelte 5 runes component library for SvelteKit. Zero Tailwind. Scoped, beautiful, performant.",
	"homepage": "https://fractalsvelte.dev/fractalsvelte-ui",
	"type": "module",
	"license": "MIT",
	"author": "Fractalmandala",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/fractalmandala/fractalsvelte-ui.git"
	},
	"bugs": {
		"url": "https://github.com/fractalmandala/fractalsvelte-ui/issues"
	},
	"keywords": [
		"svelte",
		"svelte5",
		"sveltekit",
		"runes",
		"components",
		"ui",
		"design-system",
		"design-tokens"
	],
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"css": "node scripts/build-css.mjs",
		"package": "svelte-package && node scripts/build-css.mjs",
		"prepack": "svelte-kit sync && svelte-package && node scripts/build-css.mjs && publint",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"docs:components": "node scripts/component-docs.mjs"
	},
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*"
	],
	"sideEffects": [
		"**/*.css",
		"**/*.sass"
	],
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./types": {
			"types": "./dist/types.d.ts",
			"default": "./dist/types.js"
		},
		"./css": {
			"types": "./dist/asset.d.ts",
			"default": "./dist/css/fractalsvelte-ui.css"
		},
		"./css/min": {
			"types": "./dist/asset.d.ts",
			"default": "./dist/css/fractalsvelte-ui.min.css"
		},
		"./styles": {
			"types": "./dist/asset.d.ts",
			"default": "./dist/styles/index.sass"
		},
		"./styles/*": "./dist/styles/*",
		"./tokens.css": {
			"types": "./dist/asset.d.ts",
			"default": "./dist/styles/tokens.css"
		},
		"./package.json": "./package.json"
	},
	"dependencies": {
		"@fractaldesign/icons": "^0.1.0"
	},
	"peerDependencies": {
		"@fractaldesign/fractalstyler": "^1.5.0",
		"sass": "^1.102.0",
		"svelte": "^5.0.0"
	},
	"peerDependenciesMeta": {
		"sass": {
			"optional": true
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"@parcel/watcher"
		]
	},
	"devDependencies": {
		"@fractaldesign/fractalstyler": "file:/Users/amrit/fractaldesign/packages/fractalstyler",
		"@fractaldesign/pop-svelte": "^0.3.1",
		"@sveltejs/adapter-auto": "^8.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/package": "^2.5.8",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@types/node": "^24.0.0",
		"mdsvex": "^0.12.8",
		"publint": "^0.3.21",
		"sass": "^1.105.1",
		"sv-agentation": "^0.4.0",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.0"
	},
	"imports": {
		"#lib": "./src/lib/index.ts",
		"#lib/*": "./src/lib/*"
	}
}
