{
	"name": "@fractaldesign/fractalsvelte-ui",
	"version": "0.7.0",
	"description": "Massive, modern, token-driven Svelte 5 runes component library for SvelteKit. Zero Tailwind. Scoped, beautiful, performant.",
	"type": "module",
	"license": "MIT",
	"author": "Fractalmandala",
	"keywords": [
		"svelte",
		"svelte5",
		"sveltekit",
		"runes",
		"components",
		"ui",
		"design-system",
		"design-tokens"
	],
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"package": "svelte-package",
		"prepack": "svelte-kit sync && svelte-package && publint",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"docs:extract": "node scripts/extract-docs.mjs",
		"docs:check": "node scripts/docs-check.mjs"
	},
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*",
		"!dist/documentation"
	],
	"sideEffects": [
		"**/*.css"
	],
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js"
		},
		"./components/*": {
			"types": "./dist/components/*.d.ts",
			"svelte": "./dist/components/*"
		},
		"./tokens.css": "./dist/styles/tokens.css",
		"./types": {
			"types": "./dist/types.d.ts",
			"default": "./dist/types.js"
		},
		"./view-transitions": {
			"types": "./dist/view-transitions.d.ts",
			"default": "./dist/view-transitions.js"
		},
		"./transitions": {
			"types": "./dist/transitions.d.ts",
			"default": "./dist/transitions.js"
		},
		"./package.json": "./package.json"
	},
	"peerDependencies": {
		"svelte": "^5.0.0"
	},
	"publishConfig": {
		"access": "public"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"@parcel/watcher"
		]
	},
	"devDependencies": {
		"@sveltejs/adapter-auto": "^8.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/package": "^2.5.8",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@types/node": "^24.0.0",
		"publint": "^0.3.21",
		"sass": "^1.105.1",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.0"
	},
	"imports": {
		"#lib": "./src/lib/index.ts",
		"#lib/*": "./src/lib/*"
	}
}
