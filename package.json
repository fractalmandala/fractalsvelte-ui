{
	"name": "@fractaldesign/fractalsvelte-ui",
	"version": "1.5.0",
	"description": "A complete SvelteKit component super-library: component kits, spring physics, motion, view transitions and parametric themes — styled only with fractalstyler.",
	"license": "MIT",
	"author": "Fractalmandala",
	"keywords": [
		"svelte",
		"svelte5",
		"sveltekit",
		"components",
		"ui",
		"design-system",
		"spring",
		"motion",
		"view-transitions",
		"fractalstyler"
	],
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*",
		"!dist/**/examples/**"
	],
	"type": "module",
	"sideEffects": [
		"**/*.css"
	],
	"types": "./dist/index.d.ts",
	"svelte": "./dist/index.js",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./motion": {
			"types": "./dist/motion/index.d.ts",
			"svelte": "./dist/motion/index.js",
			"default": "./dist/motion/index.js"
		},
		"./theme": {
			"types": "./dist/theme/index.d.ts",
			"svelte": "./dist/theme/index.js",
			"default": "./dist/theme/index.js"
		},
		"./styles": "./dist/styles/custom.css",
		"./package.json": "./package.json"
	},
	"scripts": {
		"dev": "node scripts/gen.ts && vite dev",
		"gen": "node scripts/gen.ts",
		"gate": "node scripts/gate.ts",
		"verify": "node scripts/verify.ts",
		"lint": "node node_modules/@fractaldesign/fractalstyler/lint/cli.ts .",
		"build": "node scripts/gen.ts && vite build && pnpm run prepack",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"prepack": "svelte-kit sync && svelte-package && publint",
		"check": "node scripts/gen.ts && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && pnpm run lint && node scripts/gate.ts",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch"
	},
	"peerDependencies": {
		"@fractaldesign/fractalstyler": "^2.0.0",
		"svelte": "^5.40.0"
	},
	"dependencies": {
		"@fractaldesign/icons": "^0.1.0"
	},
	"devDependencies": {
		"@fractaldesign/fractalstyler": "link:../fractalstyler",
		"@sveltejs/adapter-static": "^4.0.1",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/package": "^2.5.8",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@types/node": "^26.6.6",
		"publint": "^0.3.21",
		"sass": "^1.108.2",
		"svelte": "^5.57.2",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.0"
	},
	"engines": {
		"node": ">=22.18"
	},
	"homepage": "https://fractalsvelte.dev/fractalsvelte-ui",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/fractalmandala/fractalsvelte-ui.git"
	},
	"bugs": {
		"url": "https://github.com/fractalmandala/fractalsvelte-ui/issues"
	},
	"publishConfig": {
		"access": "public"
	}
}
