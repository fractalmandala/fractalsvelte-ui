{
	"name": "@fractaldesign/fractalsvelte-ui",
	"version": "1.2.0",
	"description": "Svelte 5 component library styled by one class-and-token stylesheet: every prop value is a class you can read. No Tailwind, no runtime CSS-in-JS.",
	"homepage": "https://fractalsvelte.dev/fractalsvelte-ui",
	"type": "module",
	"license": "MIT",
	"author": "Fractalmandala",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/fractalmandala/fractalsvelte-ui.git"
	},
	"bugs": {
		"url": "https://github.com/fractalmandala/fractalsvelte-ui/issues"
	},
	"keywords": [
		"svelte",
		"svelte5",
		"sveltekit",
		"runes",
		"components",
		"ui",
		"design-system",
		"design-tokens",
		"css"
	],
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"css": "node scripts/build-css.mjs",
		"icons": "node scripts/build-icons.mjs",
		"package": "node scripts/build-icons.mjs && svelte-package && node scripts/build-css.mjs",
		"prepack": "node scripts/build-icons.mjs && svelte-kit sync && svelte-package && node scripts/build-css.mjs && publint",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"docs:components": "node scripts/component-docs.mjs"
	},
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*"
	],
	"sideEffects": [
		"**/*.css"
	],
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./types": {
			"types": "./dist/types.d.ts",
			"default": "./dist/types.js"
		},
		"./css": {
			"types": "./dist/asset.d.ts",
			"default": "./dist/css/fractalsvelte-ui.css"
		},
		"./css/min": {
			"types": "./dist/asset.d.ts",
			"default": "./dist/css/fractalsvelte-ui.min.css"
		},
		"./styles": {
			"types": "./dist/asset.d.ts",
			"default": "./dist/styles/index.css"
		},
		"./icons": {
			"types": "./dist/icons/index.d.ts",
			"svelte": "./dist/icons/index.js",
			"default": "./dist/icons/index.js"
		},
		"./icons/keylinestroke": {
			"types": "./dist/icons/keylinestroke.d.ts",
			"svelte": "./dist/icons/keylinestroke.js",
			"default": "./dist/icons/keylinestroke.js"
		},
		"./icons/keylinefill": {
			"types": "./dist/icons/keylinefill.d.ts",
			"svelte": "./dist/icons/keylinefill.js",
			"default": "./dist/icons/keylinefill.js"
		},
		"./styles/*": "./dist/styles/*",
		"./package.json": "./package.json"
	},
	"peerDependencies": {
		"svelte": "^5.0.0"
	},
	"publishConfig": {
		"access": "public"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"@parcel/watcher"
		]
	},
	"devDependencies": {
		"@fractaldesign/pop-svelte": "^0.3.1",
		"@sveltejs/adapter-auto": "^8.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/package": "^2.5.8",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@types/node": "^24.0.0",
		"mdsvex": "^0.12.8",
		"publint": "^0.3.21",
		"sass": "^1.105.1",
		"sv-agentation": "^0.4.0",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.0"
	}
}
