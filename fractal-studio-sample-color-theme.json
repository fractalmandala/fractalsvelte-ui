  "semanticTokenColors": {
    "type": "#3A7CA5",
    "class": "#3A7CA5",
    "interface": "#3A7CA5",
    "enum": "#3A7CA5",
    "namespace": "#3A7CA5",
    "function": "#D7DAE0",
    "method": "#D7DAE0",
    "variable": "#D7DAE0",
    "parameter": "#D7DAE0",
    "property": "#3A7CA5",
    "enumMember": "#3A7CA5",
    "keyword": "#F0873A",
    "operator": "#8B93A1",
    "string": "#3A7CA5",
    "number": "#3A7CA5",
    "comment": {
      "foreground": "#6E747A",
      "fontStyle": "italic"
    },
    "*.deprecated": {
      "strikethrough": true
    }
  },
  "tokenColors": [
    {
      "name": "Comment",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#6E747A",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keyword",
      "scope": [
        "keyword",
        "storage",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#F0873A"
      }
    },
    {
      "name": "String",
      "scope": [
        "string",
        "string.quoted",
        "string.template"
      ],
      "settings": {
        "foreground": "#3A7CA5"
      }
    },
    {
      "name": "Number / constant",
      "scope": [
        "constant.numeric",
        "constant.language",
        "support.constant"
      ],
      "settings": {
        "foreground": "#3A7CA5"
      }
    },
    {
      "name": "Function",
      "scope": [
        "entity.name.function",
        "support.function",
        "variable.function"
      ],
      "settings": {
        "foreground": "#D7DAE0"
      }
    },
    {
      "name": "Type / class",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#3A7CA5"
      }
    },
    {
      "name": "Operator",
      "scope": [
        "keyword.operator",
        "punctuation.separator.key-value"
      ],
      "settings": {
        "foreground": "#8B93A1"
      }
    },
    {
      "name": "Variable / property",
      "scope": [
        "variable",
        "variable.other",
        "variable.parameter",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#D7DAE0"
      }
    },
    {
      "name": "Markdown heading",
      "scope": [
        "markup.heading",
        "entity.name.section"
      ],
      "settings": {
        "foreground": "#3A7CA5",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#E65050"
      }
    }
  ]
}
